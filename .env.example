# Copy to .env and fill in. Never commit real secrets.

# Sanity (server + dotenv in src/lib/sanity.ts)
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01

# Same IDs — required for embedded Studio in the browser (sanity.config.ts)
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production

# Optional: Sanity webhook → your API route (e.g. verify deploy hook payload)
SANITY_WEBHOOK_SECRET=your_webhook_secret

# Google Analytics 4 (client — only loads after cookie consent)
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
