---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { ContactForm } from '@/components/site/ContactForm';
import adriaintelDalmatiaHill from '../assets/adriaintel-dalmatia-hill.png';
---

<Layout
	title="Contact | AdriaIntel"
	description="Have a market you’re trying to understand? Get in touch for an independent perspective across the seafood value chain."
>
	<main class="mx-auto max-w-7xl px-6 pb-20 pt-32">
		<header class="motion-reveal mb-20">
			<div class="max-w-3xl">
				<span class="font-label mb-4 block text-xs uppercase tracking-widest text-tertiary"
					>Get in Touch</span
				>
				<h1
					class="mb-6 text-5xl font-extrabold leading-tight tracking-tight text-primary md:text-7xl"
				>
					Let's talk seafood
				</h1>
				<div class="max-w-2xl space-y-4 text-lg leading-relaxed text-secondary md:text-xl">
					<p>
						Have a market you’re trying to understand, an opportunity you’re exploring, or a question
						you need an independent perspective on?
					</p>
					<p>
						I work with companies, investors and organisations across the seafood value chain — from
						fisheries and aquaculture to processing, trade and markets.
					</p>
					<p>If there’s something you’re working through, get in touch.</p>
				</div>
			</div>
		</header>

		<div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12">
			<div
				class="motion-reveal-scale relative overflow-hidden rounded-xl bg-surface-container-lowest p-8 editorial-shadow md:col-span-7 md:p-12"
			>
				<div class="absolute right-0 top-0 h-32 w-32 rounded-bl-3xl bg-primary-container opacity-5"></div>
				<ContactForm variant="light" client:visible />
			</div>

			<div class="space-y-8 lg:col-span-5">
				<div class="motion-reveal-scale motion-delay-1 group relative isolate aspect-[4/3] overflow-hidden rounded-xl editorial-shadow">
					<Image
						class="absolute inset-0 z-0 h-full w-full object-cover grayscale-[0.2] transition-transform duration-700 group-hover:scale-105"
						src={adriaintelDalmatiaHill}
						alt="Mediterranean coastline"
						width={800}
						height={600}
						loading="lazy"
						sizes="(min-width: 1024px) 42vw, 100vw"
					/>
					<div class="absolute inset-0 z-1 bg-primary/12"></div>
					<div
						class="glass-nav absolute bottom-6 left-6 right-6 z-2 flex items-center justify-between rounded-xl bg-white/60 p-6"
					>
						<div>
							<p class="font-headline font-bold text-primary">Split, Croatia</p>
							<p class="font-label text-[10px] uppercase tracking-widest text-secondary">Coastal HQ</p>
						</div>
						<div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-on-primary">
							<span class="material-symbols-outlined text-sm">explore</span>
						</div>
					</div>
					<div
						class="contact-map-pulse absolute left-1/2 top-1/2 z-3 h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full bg-tertiary ring-8 ring-tertiary/20"
					>
					</div>
				</div>

				<div class="motion-reveal motion-delay-2 space-y-8 rounded-xl bg-surface-container-low p-10">
					<div class="flex items-start gap-4">
						<div class="rounded-lg bg-primary-container/20 p-3 text-primary">
							<span class="material-symbols-outlined">mail</span>
						</div>
						<div>
							<h4 class="font-headline text-lg font-bold text-primary">Mail</h4>
							<p class="text-secondary">
								<a class="hover:text-primary" href="mailto:leana@adriaintel.com">leana@adriaintel.com</a>
							</p>
						</div>
					</div>
					<div class="flex items-start gap-4">
						<div class="rounded-lg bg-primary-container/20 p-3 text-primary">
							<span class="material-symbols-outlined">call</span>
						</div>
						<div>
							<h4 class="font-headline text-lg font-bold text-primary">HQ Croatia</h4>
							<p class="text-secondary">
								<a class="hover:text-primary" href="tel:+385953625191">+385 95 3625 191</a>
							</p>
						</div>
					</div>
					<div class="flex items-start gap-4">
						<div class="rounded-lg bg-primary-container/20 p-3 text-primary">
							<span class="material-symbols-outlined">call</span>
						</div>
						<div>
							<h4 class="font-headline text-lg font-bold text-primary">HQ Norway</h4>
							<p class="text-secondary">
								<a class="hover:text-primary" href="tel:+4745861328">+47 45 86 13 28</a>
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>
