---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import adriaintelCoastCity from '../assets/adriaintel-coast-city.png';
import adriaintelGraphs from '../assets/adriaintel-graphs.png';
---

<Layout
	title="About | AdriaIntel - Coastal Precision, Global Expertise"
	description="AdriaIntel bridges traditional maritime wisdom and high-precision digital intelligence for the global seafood market."
>
	<main class="pt-32">
		<section class="mx-auto mb-32 grid max-w-7xl grid-cols-1 items-center gap-8 px-8 md:grid-cols-12">
			<div class="motion-reveal z-10 md:col-span-7">
				<span class="font-label mb-4 block text-xs uppercase tracking-[0.2em] text-secondary"
					>Our Origin Story</span
				>
				<h1
					class="font-headline mb-8 text-5xl font-extrabold leading-[1.1] tracking-tight text-primary md:text-7xl"
				>
					Bridging the Deep Sea with <span class="text-tertiary">Bespoke Intelligence.</span>
				</h1>
				<p class="max-w-xl text-lg leading-relaxed text-secondary">
					AdriaIntel was founded on the rugged Dalmatian coast, born from a necessity to translate
					traditional maritime wisdom into high-precision digital assets. We don't just harvest data; we
					curate insights for the global seafood market.
				</p>
			</div>
			<div class="motion-fade motion-delay-1 relative md:col-span-5">
				<div
					class="aspect-[4/5] overflow-hidden rounded-xl editorial-shadow md:translate-x-12 md:translate-y-12"
				>
					<Image
						class="h-full w-full object-cover"
						src={adriaintelCoastCity}
						alt="Adriatic coastline"
						width={640}
						height={800}
						loading="eager"
						sizes="(min-width: 768px) 42vw, 100vw"
					/>
				</div>
				<div
					class="absolute -bottom-8 -left-8 hidden max-w-[240px] rounded-xl bg-surface-container-highest p-8 editorial-shadow md:block"
				>
					<span class="material-symbols-outlined mb-4 text-4xl text-tertiary">analytics</span>
					<p class="font-headline text-xl font-bold text-primary">15+ Years</p>
					<p class="text-sm text-secondary">
						Of technical maritime data curation across Mediterranean basins.
					</p>
				</div>
			</div>
		</section>

		<section class="mb-32 bg-surface-container-low py-32">
			<div class="mx-auto max-w-7xl px-8">
				<div class="flex flex-col items-start justify-between gap-16 md:flex-row">
					<div class="md:w-1/3">
						<h2 class="font-headline mb-6 text-3xl font-bold text-primary">Our Mission</h2>
						<div class="h-1 w-20 bg-tertiary"></div>
					</div>
					<div class="md:w-2/3">
						<p
							class="font-headline mb-8 text-2xl leading-snug text-primary-container md:text-3xl"
						>
							"To empower the seafood industry through radical transparency and predictive modeling,
							ensuring the bounty of our oceans is managed with mathematical precision."
						</p>
						<p class="text-lg leading-relaxed text-secondary">
							We believe that the future of the global seafood supply chain lies in the intersection of
							biological science and advanced analytics. Our boutique approach allows us to provide
							deep-dive intelligence that generic data firms simply cannot reach.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="mx-auto mb-40 max-w-7xl px-8">
				<div class="motion-reveal mb-16 text-center">
				<span class="font-label mb-2 block text-xs uppercase tracking-[0.2em] text-secondary"
					>Our Expertise</span
				>
				<h2 class="font-headline text-4xl font-bold text-primary">Precision Frameworks</h2>
			</div>
			<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
				<div
					class="motion-reveal-scale group rounded-xl bg-surface-container-lowest p-10 editorial-shadow transition-colors duration-500 hover:bg-primary md:col-span-2"
				>
					<div class="flex h-full flex-col justify-between">
						<div>
							<span class="material-symbols-outlined mb-6 text-4xl text-tertiary group-hover:text-surface"
								>dataset</span
							>
							<h3
								class="font-headline mb-4 text-3xl font-bold text-primary group-hover:text-surface"
							>
								Biological Data Modeling
							</h3>
							<p class="max-w-lg text-secondary group-hover:text-surface-container">
								We utilize proprietary algorithms to track biomass trends and migration patterns in the
								Adriatic, providing a 360-degree view of sustainable sourcing opportunities.
							</p>
						</div>
						<div class="mt-12 flex gap-4">
							<span
								class="rounded-full bg-surface-container px-4 py-2 text-xs font-bold uppercase tracking-wider text-primary"
								>Predictive</span
							>
							<span
								class="rounded-full bg-surface-container px-4 py-2 text-xs font-bold uppercase tracking-wider text-primary"
								>Algorithmic</span
							>
						</div>
					</div>
				</div>
				<div class="motion-reveal-scale motion-delay-1 relative overflow-hidden rounded-xl bg-surface-container-highest p-10 editorial-shadow">
					<span class="material-symbols-outlined mb-6 text-4xl text-primary">monitoring</span>
					<h3 class="font-headline mb-4 text-2xl font-bold text-primary">Market Volatility Analysis</h3>
					<p class="mb-8 text-secondary">
						Real-time tracking of Mediterranean supply fluctuations and global trade impacts.
					</p>
					<div class="absolute bottom-0 right-0 h-32 w-32 opacity-10">
						<span class="material-symbols-outlined text-[8rem]">show_chart</span>
					</div>
				</div>
				<div
					class="motion-reveal-scale motion-delay-1 rounded-xl border border-outline-variant/15 bg-tertiary-container/20 p-10 editorial-shadow"
				>
					<span class="material-symbols-outlined mb-6 text-4xl text-tertiary">security</span>
					<h3 class="font-headline mb-4 text-2xl font-bold text-primary">Traceability Assurance</h3>
					<p class="text-secondary">
						Our 'Sea-to-Shelf' digital ledger ensures every data point in your supply chain is verified
						and immutable.
					</p>
				</div>
				<div
					class="motion-reveal-scale motion-delay-2 flex flex-col items-center gap-8 rounded-xl bg-surface p-10 editorial-shadow md:col-span-2 md:flex-row"
				>
					<div class="md:w-1/2">
						<Image
							class="h-48 w-full rounded-xl object-cover"
							src={adriaintelGraphs}
							alt="Maritime data workspace"
							width={800}
							height={320}
							loading="lazy"
							sizes="(min-width: 768px) 42vw, 100vw"
							decoding="async"
						/>
					</div>
					<div class="md:w-1/2">
						<h3 class="font-headline mb-3 text-2xl font-bold text-primary">Consultative Precision</h3>
						<p class="mb-4 text-sm text-secondary">
							We go beyond the dashboard. Every client receives a curated strategy lead by our principal
							analysts who understand both the water and the wire.
						</p>
						<a
							class="group inline-flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-primary"
							href="/contact"
						>
							Learn more
							<span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1"
								>arrow_forward</span
							>
						</a>
					</div>
				</div>
			</div>
		</section>

		<section class="mx-auto mb-40 max-w-4xl px-8 text-center">
			<h2 class="font-headline mb-16 text-4xl font-bold text-primary">The Adriatic Standard</h2>
			<div class="grid grid-cols-1 gap-12 md:grid-cols-3">
				<div>
					<h4 class="font-headline mb-3 text-xl font-bold uppercase tracking-tighter text-primary">
						Integrity
					</h4>
					<p class="text-sm text-secondary">
						Data that is unbiased, unpolluted, and uncompromising in its accuracy.
					</p>
				</div>
				<div>
					<h4 class="font-headline mb-3 text-xl font-bold uppercase tracking-tighter text-primary">
						Curation
					</h4>
					<p class="text-sm text-secondary">
						We filter the noise, delivering only the signals that drive maritime growth.
					</p>
				</div>
				<div>
					<h4 class="font-headline mb-3 text-xl font-bold uppercase tracking-tighter text-primary">
						Legacy
					</h4>
					<p class="text-sm text-secondary">
						Honoring the heritage of the sea through the lens of modern innovation.
					</p>
				</div>
			</div>
		</section>

		<section class="mx-auto mb-20 max-w-7xl px-8">
			<div class="motion-reveal-scale relative overflow-hidden rounded-xl bg-primary p-16 text-center text-on-primary">
				<div class="relative z-10">
					<h2 class="font-headline mb-8 text-4xl font-bold md:text-5xl">
						Ready to navigate the <br />next frontier?
					</h2>
					<a
						href="/contact"
						class="inline-block rounded-xl bg-tertiary px-10 py-4 font-headline text-lg font-bold text-on-tertiary transition-transform hover:scale-105"
					>
						Schedule a Deep Dive
					</a>
				</div>
				<div
					class="pointer-events-none absolute inset-0 opacity-10"
					style="background-image: radial-gradient(circle at 2px 2px, #e6fff4 1px, transparent 0); background-size: 40px 40px;"
				>
				</div>
			</div>
		</section>
	</main>
</Layout>
