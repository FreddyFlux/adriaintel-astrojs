---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Terms of Service | AdriaIntel"
	description="Terms of use for the AdriaIntel website."
	pathname="/terms"
>
	<main class="mx-auto max-w-3xl px-8 py-16 md:py-24">
		<h1 class="font-headline text-3xl font-black tracking-tight text-primary md:text-4xl">
			Terms of Service
		</h1>
		<p class="mt-6 font-body leading-relaxed text-on-surface-variant">
			Full terms of use for this website are being prepared. By using this site you agree to use it
			for lawful purposes and not to misuse content or systems.
		</p>
		<p class="mt-4 font-body leading-relaxed text-on-surface-variant">
			For questions, please
			<a class="text-primary underline underline-offset-2 hover:text-primary-container" href="/contact"
				>contact us</a
			>.
		</p>
	</main>
</Layout>
