---
import Layout from '../../layouts/Layout.astro';
import { ArticleFilterBar } from '@/components/site/ArticleFilterBar';
import { getAllArticles, urlFor } from '@/lib/sanity';

const posts = await getAllArticles();
const featured = posts.find((p) => p.featured) ?? posts[0];
const rest = featured ? posts.filter((p) => p._id !== featured._id) : [];

const categories = [
	...new Set(posts.map((p) => p.category).filter((c): c is string => Boolean(c))),
].sort((a, b) => a.localeCompare(b));

function fmt(d: string) {
	return new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<Layout
	title="Articles | AdriaIntel Maritime Intelligence"
	description="Advanced data analysis and editorial perspectives on Adriatic seafood markets, maritime logistics, and blue economy trends."
	pathname="/articles"
>
	<main class="pb-24 pt-32">
		<header class="mx-auto mb-20 max-w-7xl px-8">
			<div class="max-w-3xl">
				<span class="font-label mb-4 block text-xs font-bold uppercase tracking-widest text-tertiary"
					>Intelligence Hub</span
				>
				<h1
					class="font-headline mb-6 text-5xl font-extrabold leading-[0.95] tracking-tighter text-on-background md:text-7xl"
				>
					Maritime <span class="italic text-primary">Insights</span>
				</h1>
				<p class="max-w-2xl text-balance text-lg font-light leading-relaxed text-secondary md:text-xl">
					Advanced data analysis and editorial perspectives on the Adriatic seafood markets, maritime
					logistics, and emerging blue economy trends.
				</p>
			</div>
		</header>

		<section class="mx-auto mb-16 max-w-7xl px-8">
			<ArticleFilterBar client:visible categories={categories} />
		</section>

		{
			featured ? (
				<section
					class="mx-auto mb-32 max-w-7xl px-8"
					data-article-listing-item
					data-category={featured.category ?? ''}
				>
					<article class="relative grid grid-cols-1 items-center gap-0 lg:grid-cols-12">
						<div class="relative z-0 h-[500px] overflow-hidden rounded-xl lg:col-span-8">
							{featured.heroImage ? (
								<img
									class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
									src={urlFor(featured.heroImage).width(800).auto('format').url()}
									alt={featured.heroImageAlt}
									width={1200}
									height={800}
									loading="eager"
								/>
							) : null}
							<div class="absolute inset-0 bg-gradient-to-r from-primary/40 to-transparent" />
						</div>
						<div class="relative z-10 mt-[-4rem] rounded-xl bg-surface-container-lowest p-10 editorial-shadow md:p-16 lg:col-span-6 lg:col-start-7 lg:-ml-20 lg:mt-0">
							<span class="font-label mb-4 block text-[10px] font-bold uppercase tracking-widest text-tertiary">
								Featured Analysis
							</span>
							<h2 class="font-headline mb-6 text-3xl font-bold leading-tight tracking-tight text-on-surface md:text-4xl">
								{featured.title}
							</h2>
							<p class="mb-8 leading-relaxed text-secondary">{featured.excerpt}</p>
							<div class="flex items-center justify-between">
								<div class="flex items-center gap-3">
									<div class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-full bg-surface-variant">
										<span class="material-symbols-outlined text-primary">person</span>
									</div>
									<div>
										<p class="text-sm font-bold text-on-surface">
											{featured.author?.name ?? 'AdriaIntel Research'}
										</p>
										<p class="text-[10px] uppercase tracking-widest text-secondary">Editorial</p>
									</div>
								</div>
								<a
									class="group flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-primary"
									href={`/articles/${featured.slug}`}
								>
									Read Full Report
									<span class="material-symbols-outlined text-lg transition-transform group-hover:translate-x-1">
										arrow_forward
									</span>
								</a>
							</div>
						</div>
					</article>
				</section>
			) : null
		}

		<section class="mx-auto max-w-7xl px-8">
			<div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
				{
					rest.map((post) => (
						<article
							class="group flex flex-col gap-6"
							data-article-listing-item
							data-category={post.category ?? ''}
						>
							<div class="relative aspect-[4/5] overflow-hidden rounded-xl bg-surface-container">
								{post.heroImage ? (
									<img
										class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
										src={urlFor(post.heroImage).width(800).auto('format').url()}
										alt={post.heroImageAlt}
										width={600}
										height={750}
										loading="lazy"
									/>
								) : null}
								<div class="absolute left-4 top-4">
									<span class="rounded bg-surface-bright/90 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-primary backdrop-blur">
										{post.category ?? 'Insight'}
									</span>
								</div>
							</div>
							<div>
								<div class="mb-3 flex items-center gap-2">
									<span class="text-[10px] font-medium text-secondary">{fmt(post.publishedAt)}</span>
									<span class="h-1 w-1 rounded-full bg-outline-variant" />
									<span class="text-[10px] font-medium text-secondary">
										{post.readTime != null ? `${post.readTime} min read` : 'Read'}
									</span>
								</div>
								<h3 class="font-headline mb-3 text-2xl font-bold tracking-tight text-on-surface transition-colors group-hover:text-primary">
									{post.title}
								</h3>
								<p class="mb-6 line-clamp-3 text-sm leading-relaxed text-secondary">{post.excerpt}</p>
								<a
									class="inline-block border-b-2 border-transparent pb-1 text-[11px] font-bold uppercase tracking-[0.2em] text-tertiary transition-all hover:border-tertiary"
									href={`/articles/${post.slug}`}
								>
									Explore Insight
								</a>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="mx-auto mt-32 max-w-7xl px-8">
			<div class="relative overflow-hidden rounded-xl bg-primary p-12 md:p-20">
				<div class="pointer-events-none absolute right-0 top-0 h-full w-1/2 opacity-10">
					<svg class="h-full w-full object-cover" fill="none" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M0 200C0 89.5431 89.5431 0 200 0C310.457 0 400 89.5431 400 200C400 310.457 310.457 400 200 400C89.5431 400 0 310.457 0 200Z"
							fill="#e6fff4"
						/>
					</svg>
				</div>
				<div class="relative z-10 max-w-2xl">
					<h2 class="font-headline mb-6 text-3xl font-bold leading-tight text-on-primary md:text-5xl">
						Stay Ahead of the <br /><span class="italic text-on-primary-container">Maritime Curve.</span>
					</h2>
					<p class="mb-10 text-lg leading-relaxed text-on-primary-container/80">
						Get our weekly Adriatic Intelligence briefing delivered to your inbox every Monday morning.
					</p>
					<form class="flex max-w-lg flex-col gap-4 md:flex-row" method="post" action="#">
						<input
							class="flex-1 border-b-2 border-on-primary-container/30 bg-primary-container/30 px-2 py-4 font-body text-on-primary outline-none transition-all placeholder:text-on-primary-container/60 focus:border-on-primary-container"
							placeholder="Professional Email"
							type="email"
							required
						/>
						<button
							class="shrink-0 rounded-xl bg-tertiary px-8 py-4 text-sm font-bold uppercase tracking-widest text-on-tertiary-fixed transition-transform hover:scale-105"
							type="submit"
						>
							Subscribe
						</button>
					</form>
				</div>
			</div>
		</section>
	</main>
</Layout>
