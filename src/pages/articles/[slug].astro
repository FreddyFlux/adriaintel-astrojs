---
import Layout from '../../layouts/Layout.astro';
import PortableTextRenderer from '@/components/content/PortableTextRenderer.astro';
import { getAllArticles, getArticleBySlug, urlFor } from '@/lib/sanity';

export async function getStaticPaths() {
	const articles = await getAllArticles();
	return articles.map((article) => ({
		params: { slug: article.slug },
	}));
}

const { slug } = Astro.params;
const article = await getArticleBySlug(slug!);

if (!article) {
	throw new Error(`Article not found: ${slug}`);
}

const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';
const pageTitle = article.seoTitle?.trim() || article.title;
const pageDescription = article.seoDescription?.trim() || article.excerpt;
const ogSource = article.ogImage ?? article.heroImage;
const ogImageUrl = ogSource
	? urlFor(ogSource).width(1200).height(630).auto('format').url()
	: undefined;
const ogAbsolute =
	ogImageUrl == null
		? undefined
		: ogImageUrl.startsWith('http')
			? ogImageUrl
			: siteUrl
				? `${siteUrl}${ogImageUrl.startsWith('/') ? ogImageUrl : `/${ogImageUrl}`}`
				: ogImageUrl;

const heroUrl = article.heroImage
	? urlFor(article.heroImage).width(1200).height(630).auto('format').url()
	: undefined;

const publishedAt = new Date(article.publishedAt);
const updatedAt = article.updatedAt ? new Date(article.updatedAt) : null;

const authorName = article.author?.name ?? 'AdriaIntel';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: article.title,
	description: pageDescription,
	datePublished: publishedAt.toISOString(),
	...(updatedAt && { dateModified: updatedAt.toISOString() }),
	author: {
		'@type': 'Person',
		name: authorName,
	},
	publisher: {
		'@type': 'Organization',
		name: 'AdriaIntel',
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': siteUrl ? `${siteUrl}/articles/${article.slug}` : Astro.url.href,
	},
	...(ogAbsolute && { image: ogAbsolute }),
};
---

<Layout
	title={`${pageTitle} | AdriaIntel`}
	description={pageDescription}
	pathname={`/articles/${article.slug}`}
	ogType="article"
	ogImage={ogAbsolute}
	jsonLd={jsonLd}
>
	<main class="mx-auto max-w-3xl px-6 pb-24 pt-32">
		<article>
			<p class="font-label motion-reveal mb-4 text-xs uppercase tracking-widest text-tertiary">
				{article.category ?? 'Maritime Intelligence'}
			</p>
			<h1 class="font-headline motion-reveal motion-delay-1 mb-6 text-4xl font-bold tracking-tight text-primary md:text-5xl" transition:name={`article-title-${article.slug}`}>
				{article.title}
			</h1>
			<p class="motion-reveal motion-delay-2 mb-10 text-secondary">{article.excerpt}</p>
			<div class="motion-reveal motion-delay-3 mb-12 flex flex-wrap gap-4 text-sm text-secondary">
				<time datetime={publishedAt.toISOString()}>
					{publishedAt.toLocaleDateString('en-US', {
						year: 'numeric',
						month: 'long',
						day: 'numeric',
					})}
				</time>
				{article.readTime != null ? <span>{article.readTime} min read</span> : null}
				<span>{authorName}</span>
			</div>
			{
				heroUrl ? (
					<img
						class="mb-12 w-full rounded-xl object-cover editorial-shadow"
						src={heroUrl}
						alt={article.heroImageAlt}
						width={1200}
						height={630}
						loading="eager"
						transition:name={`article-image-${article.slug}`}
					/>
				) : null
			}
			{article.body ? <PortableTextRenderer value={article.body} /> : null}
		</article>
		<p class="mt-16">
			<a class="font-headline font-bold text-primary" href="/articles">← Back to articles</a>
		</p>
	</main>
</Layout>
