---
import type { Block, Props as $ } from 'astro-portabletext/lib/types';
import { usePortableText } from 'astro-portabletext/utils';

export type Props = $<Block>;

const props = Astro.props;
const { node, index, isInline, ...attrs } = props;
const styleIs = (style: string) => style === node.style;

const { getUnknownComponent } = usePortableText(node);

const UnknownStyle = getUnknownComponent();
---

{
	styleIs('h2') ? (
		<h2
			class="font-headline mt-12 text-2xl font-bold text-primary md:text-3xl [&+p]:mt-4"
			{...attrs}
		>
			<slot />
		</h2>
	) : styleIs('h3') ? (
		<h3 class="font-headline mt-8 text-xl font-bold text-primary md:text-2xl [&+p]:mt-4" {...attrs}>
			<slot />
		</h3>
	) : styleIs('normal') ? (
		<p class="text-secondary [&_strong]:font-semibold [&_strong]:text-on-surface" {...attrs}>
			<slot />
		</p>
	) : (
		<UnknownStyle {...props}>
			<slot />
		</UnknownStyle>
	)
}
