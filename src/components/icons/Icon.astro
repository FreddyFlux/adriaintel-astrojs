---
import { icons, type IconName } from "./icons";

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
	class:list={["icon", className]}
	viewBox="0 -960 960 960"
	aria-hidden="true"
	focusable="false"
>
	<path d={icons[name]}></path>
</svg>
